{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://act3ai.com/schemas/task_envelope.v1.schema.json",
  "title": "Task envelope v1 (pm/task_queue.mdx §13.2)",
  "description": "One job as callers submit it on submit.<caller>.<category>. Media never rides on the bus: inputs and outputs are URLs. Implemented in code: ~/BGit/act3/ai_processing_server/code/internal/queue/queue.go — Envelope, Envelope.Validate",
  "type": "object",
  "required": ["envelope_version", "job_id", "caller", "category", "service", "priority", "issued_at", "expires_at", "data_rules", "reply"],
  "additionalProperties": false,
  "properties": {
    "envelope_version": { "const": 1 },
    "job_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "The caller's id; re-submitting it is a no-op (§16.4)." },
    "caller": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$", "description": "local | act3 | wtc (data/queue/callers.yaml)" },
    "category": { "type": "string", "description": "data/queue/categories.yaml" },
    "service": { "type": "string", "description": "a data/services/<id>.yaml id" },
    "model": { "type": "string" },
    "caller_job_type": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 300 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time", "description": "at most 7 days after issued_at" },
    "deadline": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "tenant": { "type": "object" },
    "estimate": { "type": "object" },
    "timeout_seconds": { "type": "integer", "minimum": 0, "description": "0: the service catalog's timeouts.run" },
    "max_attempts": { "type": "integer", "minimum": 0, "maximum": 26, "description": "0: the service catalog's retry.max_attempts" },
    "inputs": { "type": "array", "items": { "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "path": { "type": "string", "description": "caller local only" },
                      "sha256": { "type": "string" }, "bytes": { "type": "integer" } } } },
    "params": { "type": "object" },
    "outputs": { "type": "array", "items": { "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "content_type": { "type": "string" },
                      "upload": { "type": "object", "required": ["method", "url"], "properties": { "method": { "type": "string" }, "url": { "type": "string" } } } } } },
    "data_rules": { "type": "object", "properties": { "customer_data": { "type": "boolean" }, "retain_after_upload": { "type": "boolean" } } },
    "reply": { "type": "object", "required": ["events"], "properties": { "events": { "type": "string", "description": "evt.<caller>.<job_id>" }, "webhook": { "type": ["string", "null"] } } }
  }
}
