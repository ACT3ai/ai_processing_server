# Generated by `ai_processing_server broker config` from data/queue/nats/worker.conf.tmpl. Do not edit by hand:
# change this_server.yaml (queue:) and run `just broker-config` again.
# Worker: this machine's leaf node, outbound to the hub (pm/task_queue.mdx §8.1). It keeps its own JetStream domain
# so jobs held here and events written during a link cut survive until the link is back.
server_name: "{{.ServerName}}"
host: "{{.Host}}"
port: {{.Port}}
http: "127.0.0.1:{{.MonitorPort}}"

jetstream {
  store_dir: "{{.StoreDir}}"
  max_file_store: {{.MaxFileStore}}
  max_memory_store: 268435456
  domain: "{{.Domain}}"
}

leafnodes {
  remotes: [
    {
      url: "{{.HubURL}}"
{{- if .Credentials}}
      credentials: "{{.Credentials}}"
{{- end}}
    }
  ]
}

max_payload: 1MB
