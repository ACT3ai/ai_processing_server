# Generated by `ai_processing_server broker config` from data/queue/nats/standalone.conf.tmpl. Do not edit by hand:
# change this_server.yaml (queue:) and run `just broker-config` again.
# Standalone: this machine's own broker, no link to a hub (pm/task_queue.mdx §8.1).
server_name: "{{.ServerName}}"
host: "{{.Host}}"
port: {{.Port}}
http: "127.0.0.1:{{.MonitorPort}}"

jetstream {
  store_dir: "{{.StoreDir}}"
  max_file_store: {{.MaxFileStore}}
  max_memory_store: 268435456
  # fsync every write (D-026). The default (every 2 minutes) can lose acknowledged submissions, events and job_state
  # writes on a power cut; our volume is a few writes a second, so the cost is nothing.
  sync_interval: always
}

max_payload: 1MB
